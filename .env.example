# ──────────────────────────────────────────────────────────────
# Environment template — copy to `.env` and fill in real values.
#   cp .env.example .env
# All keys are build-time public (Create React App inlines any
# REACT_APP_* var into the client bundle), so use browser-restricted
# keys only. Never commit the real `.env` (it is .gitignored).
# ──────────────────────────────────────────────────────────────

# Mapbox GL token — powers the base map tiles + editor canvas.
REACT_APP_MAPBOX_TOKEN=

# Google Maps Platform key — enables live Google Places Autocomplete
# and Place Details (photos, ratings, addresses). When empty the app
# runs the local geometric simulation fallback at zero cost.
REACT_APP_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 Client ID — for the Google SSO sign-in handshake.
REACT_APP_GOOGLE_CLIENT_ID=
